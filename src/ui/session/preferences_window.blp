using Gtk 4.0;
using Adw 1;

template $PaplPreferencesWindow : Adw.PreferencesWindow {
  title: _("Preferences");

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Color Scheme");

      Adw.ActionRow {
        title: _("Follow System Colors");
        activatable-widget: follow_system_colors_switch;

        Switch follow_system_colors_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Dark Theme");
        activatable-widget: dark_theme_switch;

        Switch dark_theme_switch {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Chat Behavior");

      Adw.ActionRow {
        title: _("Send with Enter");
        subtitle: _("Press Shift+Enter for a new line");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Notifications");
    icon-name: "preferences-system-notifications-symbolic";

    Adw.PreferencesGroup {
      title: _("Chat Notifications");

      Adw.ActionRow {
        title: _("Private Chats");
        subtitle: _("Show notifications for private messages");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Groups");
        subtitle: _("Show notifications for group chats");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Channels");
        subtitle: _("Show notifications for channel broadcasts");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Privacy & Security");
    icon-name: "security-high-symbolic";

    Adw.PreferencesGroup {
      title: _("Security");

      Adw.ActionRow {
        title: _("Active Sessions");
        subtitle: _("View and terminate other connected devices");

        Button {
          label: _("Manage");
          action-name: "session.show-sessions";
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Two-Step Verification (2FA)");
        subtitle: _("Protect your account with an additional password");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Storage");
    icon-name: "drive-harddisk-symbolic";

    Adw.PreferencesGroup {
      title: _("Storage Usage");

      Adw.ActionRow {
        title: _("Cache Size");

        Label cache_size_label {
          styles ["dim-label"]
        }
      }

      Button {
        styles ["pill", "suggested-action"]

        label: _("Clear Cache");
        action-name: "preferences.clear-cache";
        halign: center;
        margin-top: 18;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Language");
    icon-name: "preferences-desktop-locale-symbolic";

    Adw.PreferencesGroup {
      title: _("Interface Language");

      Adw.ActionRow {
        title: _("Português (Brasil)");
        subtitle: _("Idioma padrão da comunidade RicardTech");

        Image {
          icon-name: "object-select-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Proxy");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup {
      title: _("Proxy Settings");

      Adw.ActionRow {
        title: _("Use Proxy");
        subtitle: _("Connect through a proxy server");

        Switch {
          valign: center;
        }
      }

      Adw.ComboRow {
        title: _("Proxy Type");
        model: Gtk.StringList {
          strings [
            "MTProto",
            "SOCKS5",
            "HTTP"
          ]
        };
      }

      Adw.EntryRow {
        title: _("Server / Host");
      }

      Adw.EntryRow {
        title: _("Port");
      }

      Adw.PasswordEntryRow {
        title: _("Secret / Password");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("System & Startup");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Background Behavior");

      Adw.ActionRow {
        title: _("Start with System");
        subtitle: _("Launch PaperPlane automatically on system boot");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Close to Notification Area");
        subtitle: _("Keep running in the background when the window is closed");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }
}
