using Gtk 4.0;
using Adw 1;

template $PaplPreferencesWindow : Adw.PreferencesWindow {
  title: _("Configurações");

  Adw.PreferencesPage {
    title: _("Geral");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Esquema de cores");

      Adw.ActionRow {
        title: _("Seguir cores do sistema");
        activatable-widget: follow_system_colors_switch;

        Switch follow_system_colors_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Tema escuro");
        activatable-widget: dark_theme_switch;

        Switch dark_theme_switch {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Comportamento do Chat");

      Adw.ActionRow {
        title: _("Enviar com Enter");
        subtitle: _("Pressione Shift+Enter para uma nova linha");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Notificações");
    icon-name: "preferences-system-notifications-symbolic";

    Adw.PreferencesGroup {
      title: _("Notificações de Conversas");

      Adw.ActionRow {
        title: _("Conversas Privadas");
        subtitle: _("Exibir notificações para mensagens privadas");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Grupos");
        subtitle: _("Exibir notificações para chats em grupo");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Canais");
        subtitle: _("Exibir notificações para transmissões de canais");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Privacidade e Segurança");
    icon-name: "security-high-symbolic";

    Adw.PreferencesGroup {
      title: _("Segurança");

      Adw.ActionRow {
        title: _("Sessões Ativas");
        subtitle: _("Visualizar e desconectar outros aparelhos conectados");

        Button {
          label: _("Gerenciar");
          action-name: "session.show-sessions";
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Verificação em Duas Etapas (2FA)");
        subtitle: _("Proteja sua conta com uma senha adicional");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Armazenamento");
    icon-name: "drive-harddisk-symbolic";

    Adw.PreferencesGroup {
      title: _("Uso de Armazenamento");

      Adw.ActionRow {
        title: _("Tamanho do Cache");

        Label cache_size_label {
          styles ["dim-label"]
        }
      }

      Button {
        styles ["pill", "suggested-action"]

        label: _("Limpar Cache");
        action-name: "preferences.clear-cache";
        halign: center;
        margin-top: 18;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Idioma");
    icon-name: "preferences-desktop-locale-symbolic";

    Adw.PreferencesGroup {
      title: _("Idioma da Interface");

      Adw.ComboRow {
        title: _("Selecionar Idioma");
        subtitle: _("Escolha o idioma preferido do aplicativo");
        model: Gtk.StringList {
          strings [
            "Português (Brasil)",
            "English (US)",
            "Español",
            "Français",
            "Deutsch",
            "Italiano",
            "Русский",
            "Türkçe",
            "Polski",
            "Nederlands",
            "Català",
            "Svenska",
            "Suomi",
            "Norsk Bokmål",
            "Bahasa Indonesia",
            "Українська",
            "العربية",
            "فارسی",
            "עברית",
            "中文 (简体)",
            "Ελληνικά",
            "Беларуская",
            "Português (Portugal)"
          ]
        };
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Proxy");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup {
      title: _("Configurações de Proxy");

      Adw.ActionRow {
        title: _("Usar Proxy");
        subtitle: _("Conectar através de um servidor proxy");

        Switch {
          valign: center;
        }
      }

      Adw.ComboRow {
        title: _("Tipo de Proxy");
        model: Gtk.StringList {
          strings [
            "MTProto",
            "SOCKS5",
            "HTTP"
          ]
        };
      }

      Adw.EntryRow {
        title: _("Servidor / Host");
      }

      Adw.EntryRow {
        title: _("Porta");
      }

      Adw.PasswordEntryRow {
        title: _("Segredo / Senha");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Sistema e Inicialização");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Execução em Segundo Plano");

      Adw.ActionRow {
        title: _("Iniciar com o Sistema");
        subtitle: _("Iniciar o PaperPlane automaticamente no boot");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Fechar para a Área de Notificação");
        subtitle: _("Manter em execução na bandeja ao fechar a janela");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }
}
