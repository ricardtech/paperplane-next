using Gtk 4.0;
using Adw 1;

template $PaplPreferencesWindow : Adw.PreferencesWindow {
  title: _("Configurações");
  default-width: 460;
  default-height: 680;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      styles ["telegram-profile-card-group"]

      Box {
        orientation: horizontal;
        spacing: 16;
        margin-top: 14;
        margin-bottom: 14;
        margin-start: 14;
        margin-end: 14;

        $PaplAvatar profile_avatar {
          size: 72;
          valign: center;
        }

        Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          hexpand: true;

          Label profile_name_label {
            styles ["title-2", "bold"]
            halign: start;
            label: "Ricard Play";
          }

          Label profile_phone_label {
            styles ["dim-label", "caption"]
            halign: start;
            label: "+55 81 99812 7081";
          }

          Label profile_username_label {
            styles ["dim-label", "caption"]
            halign: start;
            label: "@ricardplaynew";
          }
        }

        Button {
          styles ["flat", "circular"]
          valign: center;
          icon-name: "emblem-shared-symbolic";
          tooltip-text: _("Código QR");
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Esquema de cores e Chat");

      Adw.ActionRow {
        title: _("Seguir cores do sistema");
        activatable-widget: follow_system_colors_switch;

        Switch follow_system_colors_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Tema escuro");
        activatable-widget: dark_theme_switch;

        Switch dark_theme_switch {
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Enviar com Enter");
        subtitle: _("Pressione Shift+Enter para quebrar a linha");

        Switch {
          active: true;
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Notificações e Sons");

      Adw.ActionRow {
        title: _("Conversas Privadas");
        subtitle: _("Exibir notificações para mensagens privadas");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Grupos");
        subtitle: _("Exibir notificações para mensagens em grupos");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Canais");
        subtitle: _("Exibir notificações para transmissões de canais");

        Switch {
          active: true;
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Privacidade e Segurança");

      Adw.ActionRow {
        title: _("Sessões Ativas");
        subtitle: _("Visualizar e desconectar outros aparelhos conectados");

        Button {
          label: _("Gerenciar");
          action-name: "session.show-sessions";
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Verificação em Duas Etapas (2FA)");
        subtitle: _("Proteja sua conta com uma senha adicional");
      }
    }

    Adw.PreferencesGroup {
      title: _("Uso de Armazenamento e Cache");

      Adw.ActionRow {
        title: _("Tamanho do Cache");

        Label cache_size_label {
          styles ["dim-label"]
        }
      }

      Button {
        styles ["pill", "suggested-action"]

        label: _("Limpar Cache");
        action-name: "preferences.clear-cache";
        halign: center;
        margin-top: 14;
      }
    }

    Adw.PreferencesGroup {
      title: _("Idioma");

      Adw.ComboRow {
        title: _("Idioma da Interface");
        subtitle: _("Português (Brasil)");
        model: Gtk.StringList {
          strings [
            "Português (Brasil)",
            "English (US)",
            "Español",
            "Français",
            "Deutsch",
            "Italiano",
            "Русский",
            "Türkçe",
            "Polski",
            "Nederlands",
            "Português (Portugal)"
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Configurações de Proxy");

      Adw.ActionRow {
        title: _("Usar Proxy");
        subtitle: _("Conectar através de um servidor proxy");

        Switch {
          valign: center;
        }
      }

      Adw.ComboRow {
        title: _("Tipo de Proxy");
        model: Gtk.StringList {
          strings [
            "MTProto",
            "SOCKS5",
            "HTTP"
          ]
        };
      }

      Adw.EntryRow {
        title: _("Servidor / Host");
      }

      Adw.EntryRow {
        title: _("Porta");
      }

      Adw.PasswordEntryRow {
        title: _("Segredo / Senha");
      }
    }

    Adw.PreferencesGroup {
      title: _("Sistema e Inicialização");

      Adw.ActionRow {
        title: _("Iniciar com o Sistema");
        subtitle: _("Iniciar o PaperPlane automaticamente no boot");

        Switch {
          active: true;
          valign: center;
        }
      }

      Adw.ActionRow {
        title: _("Fechar para a Área de Notificação");
        subtitle: _("Manter em execução na bandeja ao fechar a janela");

        Switch {
          active: true;
          valign: center;
        }
      }
    }
  }
}
