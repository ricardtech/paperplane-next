<?xml version="1.0" encoding="UTF-8"?>
<interface domain="paper-plane">

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Contas / Alternar Sessão</attribute>
        <attribute name="action">session.show-sessions</attribute>
        <attribute name="icon">avatar-default-symbolic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Chats Arquivados</attribute>
        <attribute name="action">session.show-archived</attribute>
        <attribute name="icon">folder-download-symbolic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Contatos</attribute>
        <attribute name="action">session.show-contacts</attribute>
        <attribute name="icon">contact-new-symbolic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Mensagens Salvas</attribute>
        <attribute name="action">session.saved-messages</attribute>
        <attribute name="icon">bookmark-new-symbolic</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Alternar Modo Noturno</attribute>
        <attribute name="action">session.toggle-dark-mode</attribute>
        <attribute name="icon">weather-clear-night-symbolic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Configurações</attribute>
        <attribute name="action">session.show-preferences</attribute>
        <attribute name="icon">emblem-system-symbolic</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Atalhos do Teclado</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Sobre o PaperPlane Next</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>

  <template class="PaplSidebar" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout"/>
    </property>

    <child>
      <object class="AdwNavigationView" id="navigation_view">

        <child>
          <object class="AdwNavigationPage">
            <property name="tag">chats</property>
            <property name="title" translatable="yes">Chats</property>

            <child>
              <object class="AdwToolbarView" id="main_view">
                <child type="top">
                  <object class="GtkOverlay">

                    <child>
                      <object class="AdwHeaderBar">
                        <property name="show-start-title-buttons">false</property>
                        <property name="show-end-title-buttons">false</property>

                        <child type="start">
                          <object class="GtkMenuButton">
                            <style>
                              <class name="flat"/>
                              <class name="telegram-menu-btn"/>
                            </style>
                            <property name="icon-name">open-menu-symbolic</property>
                            <property name="popover">
                              <object class="GtkPopover" id="drawer_popover">
                                <style>
                                  <class name="telegram-drawer-popover"/>
                                </style>
                                <property name="has-arrow">false</property>
                                <property name="autohide">true</property>
                                <property name="position">bottom</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="width-request">280</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="telegram-drawer-header"/>
                                        </style>
                                        <property name="spacing">12</property>
                                        <child>
                                          <object class="PaplAvatar" id="drawer_avatar">
                                            <property name="size">56</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">2</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">true</property>
                                            <child>
                                              <object class="GtkLabel" id="drawer_name_label">
                                                <style>
                                                  <class name="bold"/>
                                                  <class name="drawer-name"/>
                                                </style>
                                                <property name="halign">start</property>
                                                <property name="label">Ricard Play</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="drawer_status_label">
                                                <style>
                                                  <class name="dim-label"/>
                                                  <class name="drawer-subtitle"/>
                                                </style>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Emoji de Status</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkImage">
                                            <style>
                                              <class name="dim-label"/>
                                            </style>
                                            <property name="icon-name">pan-down-symbolic</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator">
                                        <property name="orientation">horizontal</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="telegram-drawer-items"/>
                                        </style>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">sidebar.show-archived-chats</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">folder-download-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Chats arquivados</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel" id="archive_drawer_badge">
                                                    <style>
                                                      <class name="telegram-drawer-badge"/>
                                                    </style>
                                                    <property name="label">0</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">sidebar.show-sessions</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">avatar-default-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Meu Perfil</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">sidebar.show-sessions</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">system-users-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Novo Grupo</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">sidebar.show-sessions</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">speaker-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Novo Canal</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">session.show-contacts</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">contact-new-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Contatos</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">call-start-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Chamadas</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">session.saved-messages</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">bookmark-new-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Mensagens Salvas</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">session.show-preferences</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">emblem-system-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Configurações</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <style>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="spacing">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">weather-clear-night-symbolic</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Modo Noturno</property>
                                                <property name="hexpand">true</property>
                                                <property name="halign">start</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkSwitch" id="dark_mode_switch">
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="orientation">horizontal</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <style>
                                              <class name="flat"/>
                                              <class name="telegram-drawer-item"/>
                                            </style>
                                            <property name="action-name">app.about</property>
                                            <child>
                                              <object class="GtkBox">
                                                <property name="spacing">12</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">help-about-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Sobre o PaperPlane Next</property>
                                                    <property name="hexpand">true</property>
                                                    <property name="halign">start</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <accessibility>
                              <property name="label" translatable="yes">Menu</property>
                            </accessibility>
                          </object>
                        </child>

                        <property name="title-widget">
                          <object class="GtkStack" id="title_stack">
                            <property name="hhomogeneous">False</property>

                            <child>
                              <object class="GtkStackPage">
                                <property name="name">chats-label</property>

                                <property name="child">
                                  <object class="GtkButton">
                                    <style>
                                      <class name="flat"/>
                                      <class name="telegram-search-bar"/>
                                    </style>
                                    <property name="action-name">sidebar.start-search</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <property name="halign">center</property>
                                        <property name="valign">center</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">system-search-symbolic</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Buscar</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <accessibility>
                                      <property name="label" translatable="yes">Buscar</property>
                                    </accessibility>
                                  </object>
                                </property>

                              </object>
                            </child>

                            <child>
                              <object class="GtkStackPage">
                                <property name="name">archive-button</property>

                                <property name="child">
                                  <object class="GtkButton">
                                    <style>
                                      <class name="flat"/>
                                      <class name="two-line-window-title"/>
                                    </style>
                                    <property name="action-name">sidebar.show-archived-chats</property>

                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="valign">center</property>
                                        <property name="halign">center</property>
                                        <property name="spacing">6</property>

                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Chats Arquivados</property>
                                            <property name="ellipsize">end</property>
                                          </object>
                                        </child>

                                        <child>
                                          <object class="GtkLabel" id="archive_unread_label">
                                            <style>
                                              <class name="unread-count"/>
                                            </style>
                                            <property name="label">0</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </child>

                                        <child>
                                          <object class="GtkImage">
                                            <style>
                                              <class name="dim-label"/>
                                            </style>
                                            <property name="icon-name">arrow1-right-symbolic</property>
                                          </object>
                                        </child>

                                      </object>
                                    </child>

                                  </object>
                                </property>

                              </object>
                            </child>

                          </object>
                        </property>

                      </object>
                    </child>

                    <child type="overlay">
                      <object class="PaplSnow" id="snow">
                        <property name="sensitive">False</property>
                      </object>
                    </child>

                  </object>
                </child>

                <child type="top">
                  <object class="PaplSidebarChatFolderBar" id="folder_bar">
                    <binding name="chat-folder-list">
                      <lookup name="chat-folder-list" type="ClientStateSession">
                        <lookup name="session">PaplSidebar</lookup>
                      </lookup>
                    </binding>

                  </object>
                </child>

                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>

                    <child>
                      <object class="PaplSidebarChatList">
                        <binding name="chat-list">
                          <lookup name="selected-chat-list">folder_bar</lookup>
                        </binding>
                        <property name="selected-chat" bind-source="PaplSidebar" bind-property="selected-chat" bind-flags="sync-create|bidirectional"/>
                        <property name="compact" bind-source="PaplSidebar" bind-property="compact" bind-flags="sync-create"/>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>

        <child>
          <object class="AdwNavigationPage">
            <property name="tag">search</property>
            <property name="title" translatable="yes">Search</property>

            <child>
              <object class="PaplSidebarSearch" id="search">
                <binding name="session">
                  <lookup name="session">PaplSidebar</lookup>
                </binding>
                <signal name="close" handler="close_search" swapped="true"/>
              </object>
            </child>

          </object>
        </child>

        <child>
          <object class="AdwNavigationPage">
            <property name="tag">sessions</property>
            <property name="title" translatable="yes">Sessions</property>

            <child>
              <object class="PaplSessionSwitcher">
                <binding name="client-manager">
                  <lookup name="client-manager" type="Client">
                    <lookup name="client" type="ClientStateSession">
                      <lookup name="session">PaplSidebar</lookup>
                    </lookup>
                  </lookup>
                </binding>
              </object>
            </child>

          </object>
        </child>

        <child>
          <object class="AdwNavigationPage">
            <property name="tag">archived-chats</property>
            <property name="title" translatable="yes">Chats Arquivados</property>

            <child>
              <object class="AdwToolbarView">

                <child type="top">
                  <object class="AdwHeaderBar"/>
                </child>

                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>

                    <child>
                      <object class="PaplSidebarChatList">
                        <binding name="chat-list">
                          <lookup name="archive-chat-list" type="ClientStateSession">
                            <lookup name="session">PaplSidebar</lookup>
                          </lookup>
                        </binding>
                        <property name="selected-chat" bind-source="PaplSidebar" bind-property="selected-chat" bind-flags="sync-create|bidirectional"/>
                        <property name="compact" bind-source="PaplSidebar" bind-property="compact" bind-flags="sync-create"/>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

  </template>
</interface>
