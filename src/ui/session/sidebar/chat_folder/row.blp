using Gtk 4.0;

template $PaplSidebarChatFolderRow {
  layout-manager: BinLayout {};

  notify::chat-list => $on_notify_chat_list();

  GestureClick {
    button: 3;
    pressed => $on_button_3_pressed();
    released => $on_button_3_released() swapped;
  }

  GestureLongPress {
    touch-only: true;
    pressed => $on_long_pressed();
  }

  Box {
    orientation: vertical;
    spacing: 2;
    margin-start: 2;
    margin-end: 2;
    margin-top: 6;
    margin-bottom: 6;
    halign: center;

    $PaplSidebarChatFolderIcon icon {
      chat-list: bind template.chat-list;
      halign: center;
      valign: center;
    }

    Label title_label {
      styles ["chat-folder-tab-title"]

      justify: center;
      wrap: false;
      ellipsize: end;
      max-width-chars: 8;
      halign: center;
    }
  }
}
