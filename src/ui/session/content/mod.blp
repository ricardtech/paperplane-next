using Gtk 4.0;
using Adw 1;

template $Content : Adw.Bin {
  Stack stack {
    Adw.ToolbarView unselected_chat_view {
      [top]
      Overlay {
        Adw.HeaderBar {
          show-title: false;
        }

        [overlay]
        $PaplSnow PaplSnow {
          sensitive: false;
        }
      }

      content: Box {
        vexpand: true;
        hexpand: true;
        valign: center;
        halign: center;

        Label {
          styles ["telegram-empty-chat-pill"]
          label: _("Selecione um chat para começar a conversar");
        }
      };
    }

    $PaplChatHistory chat_history {
      chat: bind template.chat;
    }
  }
}
